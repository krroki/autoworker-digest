 다운 함수 (개선된 버전)\n  async function advancedScrollDown() {\n    const ironList = document.querySelector('tp-yt-iron-list');\n    if (!ironList || !ironList.scrollToIndex) {\n      console.error(\"⚠️ tp-yt-iron-list 또는 scrollToIndex 메소드 찾기 실패\");\n      return false;\n    }\n    \n    const prevCount = ironList.items ? ironList.items.length : 0;\n    ironList.scrollToIndex(prevCount - 1);\n    \n    // 새 댓글 로딩 대기 및 확인\n    return new Promise((resolve) => {\n      let attempts = 0;\n      const maxAttempts = 5; // 최대 5번 시도\n      \n      const checkNewComments = () => {\n        const currCount = ironList.items ? ironList.items.length : 0;\n        \n        if (currCount > prevCount) {\n          console.log(`🔽 스크롤 성공: ${prevCount} -> ${currCount}`);\n          resolve(true);\n        } else {\n          attempts++;\n          \n          if (attempts < maxAttempts) {\n            console.log(`⏳ 새 댓글 로딩 대기 (${attempts}/${maxAttempts})`);\n            setTimeout(checkNewComments, 2000);\n          } else {\n            console.log(\"⚠️ 새 댓글 로딩 실패\");\n            resolve(false);\n          }\n        }\n      };\n      \n      // 초기 대기 후 확인 시작\n      setTimeout(checkNewComments, 2000);\n    });\n  }\n  \n  // 화면에 처리할 댓글이 있는지 확인\n  function getProcessableComments() {\n    const allComments = document.querySelectorAll('ytcp-comment-thread');\n    return Array.from(allComments).filter(comment => {\n      // depth 속성이 0이거나 없는 댓글만 포함 (대댓글 제외)\n      const depth = comment.getAttribute('depth');\n      if (depth && depth !== \"0\") return false;\n      \n      // 이미 처리된 댓글 제외\n      const commentText = comment.textContent.trim().slice(0, 100);\n      if (processedComments.has(commentText)) return false;\n      \n      // 화면에 완전히 보이는지 확인 (조금이라도 잘리면 제외)\n      const rect = comment.getBoundingClientRect();\n      return (\n        rect.top >= 0 && \n        rect.left >= 0 && \n        rect.bottom <= window.innerHeight && \n        rect.right <= window.innerWidth\n      );\n    });\n  }\n  \n  // 현재 댓글의 하트 버튼 찾기\n  function findHeartButton(comment) {\n    const selectors = [\n      '#creator-heart-button button',\n      'ytcp-comment-creator-heart button',\n      'button[aria-label*=\"하트\"]',\n      'button[aria-label*=\"Heart\"]',\n      'button[aria-label*=\"좋아요\"]',\n      'ytcp-icon-button[aria-label*=\"하트\"]',\n      'ytcp-icon-button[aria-label*=\"Heart\"]'\n    ];\n\n    for (const selector of selectors) {\n      const button = comment.querySelector(selector);\n      \n      if (button) {\n        // 클릭 가능한 상태인지 확인\n        const isAlreadyPressed = \n          button.getAttribute('aria-pressed') === 'true' ||\n          button.classList.contains('selected') ||\n          button.classList.contains('active');\n        \n        if (!isAlreadyPressed) {\n          return button;\n        }\n      }\n    }\n    \n    return null;\n  }\n  \n  // 하트 버튼 하이라이트 및 클릭 함수\n  async function highlightAndClickHeartButton(comment) {\n    const commentText = comment.textContent.trim().slice(0, 100);\n    \n    // 이미 처리된 댓글인지 확인\n    if (processedComments.has(commentText)) return false;\n\n    const button = findHeartButton(comment);\n    if (!button) return false;\n    \n    try {\n      // 하이라이트 처리\n      comment.style.border = '2px solid green';\n      const label = document.createElement('div');\n      label.textContent = '👀';\n      label.style.position = 'absolute';\n      label.style.top = '0';\n      label.style.left = '0';\n      label.style.background = 'red';\n      label.style.color = 'white';\n      label.style.padding = '2px 6px';\n      label.style.borderRadius = '50%';\n      label.style.zIndex = '9999';\n      \n      if (comment.style.position !== 'relative') {\n        comment.style.position = 'relative';\n      }\n      comment.appendChild(label);\n\n      // 잠시 대기\n      await new Promise(r => setTimeout(r, 300));\n\n      // 클릭 시도\n      const clickEvents = [\n        () => button.click(),\n        () => ","u":"218d691e"},{"i":"f621b281e8","t":"20:36:21","s":"박@주(원씽)","k":"etc","x":"이건 혹시 수업에서 알려주셨던건가요? ㅠ ","u":"0daed5cf"},{"i":"c4579095fd","t":"20:36:25","s":"박@주(원씽)","k":"etc","x":"어찌 사용하는 건지…","u":"0daed5cf"},{"i":"018ad13ede","t":"20:36:30","s":"방@수(깨끗한싼타페)","k":"etc","x":"이거 ","u":"019fd648"},{"i":"09336436ed","t":"20:36:31","s":"쇼츠대폭발(스위칭쇼츠 2기)","k":"etc","x":"아니오 1기 때 배포해드렸던 거고","u":"218d691e"},{"i":"3cd99711c6","t":"20:36:35","s":"방@수(깨끗한싼타페)","k":"etc","x":"꿀임","u":"019fd648"},{"i":"57df9718a5","t":"20:36:36","s":"박@린(리니P)","k":"etc","x":"아항","u":"41da4ad1"},{"i":"8fcabdbd56","t":"20:36:44","s":"박@린(리니P)","k":"etc","x":"오 이런것도 있군요","u":"41da4ad1"},{"i":"8057889930","t":"20:36:51","s":"쇼츠대폭발(스위칭쇼츠 2기)","k":"etc","x":"크롬 관리자 도구에서 해주셔야 하는데 ","u":"218d691e"},{"i":"2f7037eb7e","t":"20:36:56","s":"홍@표(방학의조건)","k":"etc","x":"클로드 - 사용량 - 제한 초기화 용","u":"6480affe"},{"i":"9c4bdaea7e","t":"20:37:04","s":"박@린(리니P)","k":"etc","x":"오오~~ ","u":"41da4ad1"},{"i":"3516b27050","t":"20:37:07","s":"이@종(부바)","k":"etc","x":"자동사랑남발기 군요","u":"8508f086"},{"i":"427f754c57","t":"20:37:17","s":"박@린(리니P)","k":"etc","x":"한번 봐야겠어요^^","u":"41da4ad1"},{"i":"43db2f009b","t":"20:37:26","s":"방@수(깨끗한싼타페)","k":"etc","x":"클코한테 한번 물어보까나 ","u":"019fd648"},{"i":"4f352fe43b","t":"20:41:39","s":"쇼츠대폭발(스위칭쇼츠 2기)","k":"etc","x":"동영상","u":"218d691e"},{"i":"404d61e48c","t":"20:41:47","s":"방@수(깨끗한싼타페)","k":"etc","x":"됐당 ","u":"019fd648"},{"i":"1f076df8bf","t":"20:41:47","s":"쇼츠대폭발(스위칭쇼츠 2기)","k":"etc","x":"@all \n\n쇼츠열공님이 만들어주신 격기록 프리셋 (격투기 숏폼)이 배포되었습니다!","u":"218d691e"},{"i":"55eacb0a3f","t":"20:41:49","s":"방@수(깨끗한싼타페)","k":"etc","x":"역시 클코 짱 ","u":"019fd648"},{"i":"9936373283","t":"20:42:42","s":"이@종(부바)","k":"etc","x":"우왕 배터지겠어요 감사합니당","u":"8508f086"},{"i":"5bb42bc319","t":"20:43:06","s":"정@우 (에디쩡)","k":"etc","x":"와우...","u":"429bb474"},{"i":"a726b92ce4","t":"20:43:07","s":"정@우 (에디쩡)","k":"etc","x":"지린당...","u":"429bb474"},{"i":"88462cf085","t":"20:43:09","s":"정@우 (에디쩡)","k":"etc","x":"할건많은데","u":"429bb474"},{"i":"18bf4e6f76","t"