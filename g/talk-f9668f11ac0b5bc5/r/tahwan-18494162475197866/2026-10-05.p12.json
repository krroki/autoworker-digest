"x":"아녜요 otp는 상관없습니다 어차피 pc에서 눌러들어가게되면 ","u":"cc1f0db5"},{"i":"67a132e3d5","t":"12:54:02","s":"서@숙(아유오유)","k":"etc","x":"https://cafe.naver.com/dinohighclass/420647","u":"320021c0"},{"i":"005d02731b","t":"12:54:06","s":"김@규(lanica)","k":"etc","x":"사진","u":"66b473e8"},{"i":"32a655a1ee","t":"12:54:13","s":"김@규(lanica)","k":"etc","x":"오우 대써여대써여","u":"66b473e8"},{"i":"f6645bbed1","t":"12:55:54","s":"김@규(lanica)","k":"etc","x":"오.. otp 로그인이 댔어요 산하나 넘었당","u":"66b473e8"},{"i":"3f5a2a4e00","t":"12:56:01","s":"김@민(츠키달)","k":"etc","x":"오 되셧나요?","u":"cc1f0db5"},{"i":"85b3a150fb","t":"12:56:02","s":"김@규(lanica)","k":"etc","x":"우헤","u":"66b473e8"},{"i":"426762b3a0","t":"12:56:06","s":"김@규(lanica)","k":"etc","x":"헤헤헤 ㅋㅋㅋㅋㅋ","u":"66b473e8"},{"i":"b389ef8fda","t":"12:56:11","s":"김@규(lanica)","k":"etc","x":"감삼다","u":"66b473e8"},{"i":"f35d27b645","t":"12:56:14","s":"김@민(츠키달)","k":"etc","x":"깡계하나 안한거 적용해서 그대로 보여드려야되나싶엇는데..ㅋㅋ","u":"cc1f0db5"},{"i":"d1219b9541","t":"12:56:16","s":"김@규(lanica)","k":"etc","x":"선배님","u":"66b473e8"},{"i":"9f9206d061","t":"12:56:23","s":"김@규(lanica)","k":"etc","x":"로그인만 댔다는","u":"66b473e8"},{"i":"c681e7e732","t":"12:56:30","s":"김@규(lanica)","k":"etc","x":"이렇게 기쁠쑤가","u":"66b473e8"},{"i":"d3a82b5339","t":"12:56:32","s":"김@규(lanica)","k":"etc","x":"ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ","u":"66b473e8"},{"i":"ec567dd761","t":"12:56:33","s":"김@민(츠키달)","k":"etc","x":"이거 번호나오셔서 우선삭제하셔용 ㅋㅋ ","u":"cc1f0db5"},{"i":"2f40068c4e","t":"12:57:07","s":"김@규(lanica)","k":"etc","x":"삭제를 해야돼는게 기본폰인거죠","u":"66b473e8"},{"i":"121ce144ed","t":"12:57:40","s":"김@민(츠키달)","k":"etc","x":"네 그쵸 기본폰에서 분리하신다하셧으니까 ","u":"cc1f0db5"},{"i":"a6bc52893b","t":"12:57:47","s":"김@민(츠키달)","k":"etc","x":"요사진은 삭제하셔여 ㅋㅋ","u":"cc1f0db5"},{"i":"fa1bfed3b8","t":"12:59:07","s":"김@규(lanica)","k":"etc","x":"아 삭제를 어케하는지 몰겠는대염","u":"66b473e8"},{"i":"02cebc72f6","t":"12:59:13","s":"김@민(츠키달)","k":"etc","x":"pc신가요 아님 ","u":"cc1f0db5"},{"i":"c2adb636a2","t":"12:59:15","s":"김@민(츠키달)","k":"etc","x":"폰이신가요?","u":"cc1f0db5"},{"i":"b884d3f3d9","t":"12:59:40","s":"김@규(lanica)","k":"etc","x":"둘다 있어여","u":"66b473e8"},{"i":"c50ed1fd54","t":"12:59:50","s":"김@민(츠키달)","k":"etc","x":"PC면 저사진에 마우스두고 오른쪽 클릭하시면","u":"cc1f0db5"}]}