"},{"i":"19d2d015a1","t":"11:48:23","s":"이@표(다시도전)","k":"etc","x":"https://cafe.naver.com/dinohighclass/450951","u":"7ea22a98"},{"i":"dfdc732a98","t":"11:55:40","s":"최@규(안토바나나)","k":"etc","x":"https://cafe.naver.com/dinohighclass/450930","u":"f5d0bba2"},{"i":"19dc8f2ea8","t":"11:57:24","s":"이@제(암유어파더)","k":"etc","x":"https://cafe.naver.com/dinohighclass/450961","u":"83618446"}]}