02/2a8bdc0bdb-0-0e7d236b.jpg","w":640,"h":879}]},{"i":"4dd809c2c8","t":"21:58:11","s":"조교 힘새라","k":"text","x":"https://cafe.naver.com/f-e/cafes/31708620/articles/13?menuid=24&referrerAllArticles=false","u":"9b689a93"},{"i":"ec613e149e","t":"21:58:41","s":"조교 힘새라","k":"text","x":"2기 자료실에서 13번 게시글이용","u":"9b689a93"},{"i":"97bfd74414","t":"21:59:11","s":"조교 힘새라","k":"text","x":"세눈까마귀님...마음 얼마나 힘드실까...에고...\n\n그래도 중복은 좀더 희망이 있다고들 하니...힘내서 준비해주세요","u":"9b689a93"},{"i":"19868db0d5","t":"22:01:04","s":"서@기(세눈까마귀)","k":"text","x":"넵","u":"bc3d1647"},{"i":"d1a38efba9","t":"22:01:17","s":"서@기(세눈까마귀)","k":"text","x":"감사합니다 한번쯤은 오겠거니 했어요 ","u":"bc3d1647"},{"i":"78bc3aa598","t":"22:02:15","s":"조교 힘새라","k":"text","x":"쌤이 그때 뭐 적어준 글 있었는데...","u":"9b689a93"},{"i":"78de6d9519","t":"22:02:42","s":"조교 힘새라","k":"text","x":"온디맨드와 확인한 결과\n가이드라인 제제가 왔을때 \n아래부분 꼭 참고 하세요\n\n제가 확인한 바로는, 항소 대본 + 증명하는 영상이 너무너무 중요합니다. 여기에 제제대상에 대한 '그렇게  보였을수 있지만 사실 이거였어! 내가 증명할게' 이게 반드시 들어가야해요! \n그리고 그날 바로 올리면 괘씸죄(?)로 보지도 않고 반려하는경우가 많아요. 그러니까. 며칠 텀을 두고 최선을 다해 항소했다는 성의도 보여야해요! \n\n영상은 원테이크보다도, 실제 손움직임, 종이, 책, 촬영 + 화면녹화 편집으로 하시는것이 훨씬 확률이 높아졌습니다!\n\n불쾌 \n정보 - 그렇게 보였을 수 있지만, 시니어 노후와 직결된 문제이기 때문에 사실을 다루다 보니 더 정확한 정보전달을 위함이었다. \n\n역사 - 역사적 사실을 다루다 보니, 그 부분의 설명없이 시청자의 이해를 돕기가 힘들다, 최대한 우회해서 표현했다. \n\n이런게 들어가야 하고요 \n\n크리에이터 해석이 정말 중요합니다, 난 특히 이부분을 이렇게 해석해서 시청자에게 불안감이나 불쾌감을 주지 않도록 했다. \n\n중복, 재사용\n정보 - 같은 주제처럼 보이나, 정부의 정책이 업데이트 되면서 나도 업데이트한 내용을 다룬거다. \n\n역사 - 같은주제 처럼 보이나. 예를 들면 이순신 주제를 이순신의 생애, 이순신의 전쟁 처럼 나누어서 다른 내용을 다뤘다. \n\n크리에이터 해석도 각각 이렇게 이렇게 넣었다 \n\n이게 중요합니다. \n\n그리고 '불쾌'같은경우는 최근 무지개돌고래님께서 하루만에 항소 성공한거 메니져님이 정리해서 '실버인포롱폼 2기카페'에 올려두었습니다!\n그거 많이 참고 하셔요! \n\n그리고 제가 공지한내용 + 4강도 보시고 꼼꼼히 준비하시기 바랍니다!\n\n오늘도 난 된다! 다 된다! 할 수있다! 해낸다!!!\n우리 사랑둥이님들 오늘도 힘내세요^^ 우리 일요일에 만나요~(사랑)\n","u":"9b689a93"},{"i":"ad8059e169","t":"22:03:04","s":"조교 힘새라","k":"text","x":"요거 한번 꼼꼼히 읽어보시구요...바로 하시면 안되고 며칠 텀 두고나서 제출하셔야해요...","u":"9b689a93"},{"i":"dd81ea657d","t":"22:03:14","s":"서@기(세눈까마귀)","k":"text","x":"네","u":"bc3d1647"},{"i":"4cf5de3194","t":"22:03:19","s":"서@기(세눈까마귀)","k":"text","x":"감사합니다!","u":"bc3d1647"},{"i":"345798bac2","t":"22:03:25","s":"조교 힘새라","k":"text","x":"힘내시구요...음...미리 몇차례 맞아본 이로써...다 이겨낼수 있습니다...","u":"9b689a93"},{"i":"b61af9c8b8","t":"22:03:33","s":"조교 힘새라","k":"emoticon","x":"이모티콘","u":"9b689a93"},{"i":"83705f9f97","t":"22:03:41","s":"조교 힘새라","k":"emoticon","x":"이모티콘","u":"9b689a93"},{"i":"be54ee4d5e","t":"22:33:47","s":"문@정(달빛)","k":"text","x":"아이쿠 세눈까마귀님 ㅠㅠ 올해 진짜 너무 심하네요 ㅠㅠ\n카피 채널들이나 정지 날리지 왜 자꾸 ㅠㅠ ","u":"b2509909"},{"i":"e6bbf2ed07","t":"22:35:55","s":"이@원(무지개돌고래)","k":"text","x":"와 너무 한다 증말","u":"9e7e8af7"},{"i":"8d56549e8c","t":"22:37:16","s":"문@정(달빛)","k":"text","x":"조교님 말씀처럼, 바로 하지 마시고, 며칠 지난 후에 하시면 좋을 것 같아요. 저 처음에 잘 몰라서 메일 받자마자 바로 보냈더니 바로 거절 오더라고요 ㅠㅠ 텀을 두고 신청하는 게 좋다고 해요.","u":"b2509909"},{"i":"6523df16eb","t":"22:37:45","s":"문@정(달빛)","k":"text","x":"항소 성공하시길 바랄게요. 힘내세요!!! 우리 모두 화이팅!!!","u":"b2509909"},{"i":"1165194bbd","t":"22:46:34","s":"조교 사람은","k":"text","x":"애꿎은 우리만 왜들 그리 볶는지. 정말 따라하는 사람들 안 잡구요..\n그래도 중복은 거의 다 풀리더라구요. \n힘내시고 잘 통과되시길요. 세눈까마귀님. ㅠ","u":"14f62405"},{"i":"b52965fe99","t":"22:54:32","s":"서@기(세눈까마귀)","k":"emoticon","x":"이모티콘","u":"bc3d1647"},{"i":"f231c7eb47","t":"22:55:54","s":"서@기(세눈까마귀)","k":"text","x":"왠지 아침에 도용해간 영상신고한게 화근이 된건가 싶기도하고 ","u":"bc3d1647"},{"i":"727da012c0","t":"22:56:47","s":"서@기(세눈까마귀)","k":"text","x":"별생각이 다드네요 ㅎㅎㅎ 항소는 한 이틀 뒤에 하면 되겠죠? ","u":"bc3d1647"},{"i":"be1dda87c6","t":"22:58:32","s":"조교 사람은","k":"text","x":"아고. ㅠ 그죠. 별의 별 생각이 들죠. \n그건 아닐거예요... \n일주일 안에 하신다고 생각하시고 시도해보세요. ^^","u":"14f62405"},{"i":"20915d230a","t":"22:58:54","s":"서@기(세눈까마귀)","k":"text","x":"항소 기간에도 업로드 해도 될까요? 노출 죽을까봐서요","u":"bc3d1647"},{"i":"0239e57a39","t":"23:01:56","s":"이@원(무지개돌고래)","k":"text","x":"하시지 말라던데요","u":"9e7e8af7"},{"i":"cbb9c9d3a8","t":"23:02:01","s":"이@원(무지개돌고래)","k":"text","x":"암것도 하지 말라고","u":"9e7e8af7"},{"i":"73c88ecf20","t":"23:02:22","s":"서@기(세눈까마귀)","k":"text","x":"헛 그렇군요 ","u":"bc3d1647"},{"i":"50fbc946ce","t":"23:02:39","s":"이@원(무지개돌고래)","k":"text","x":"넹 다른 채널 고고씽~","u":"9e7e8af7"},{"i":"c43adeba85","t":"23:02:46","s":"서@기(세눈까마귀)","k":"text","x":"네 그래야겠네요 ㅋ","u":"bc3d1647"},{"i":"e3f57ac576","t":"23:03:07","s":"이@원(무지개돌고래)","k":"text","x":"넹 기운내세욤","u":"9e7e8af7"},{"i":"fc7787470a","t":"23:03:26","s":"서@기(세눈까마귀)","k":"text","x":"","u":"bc3d1647"},{"i":"3afdfc214e","t":"23:06:37","s":"조교 사람은","k":"text","x":"맞아요. 항소풀리실때까지는 아무것도요. ^^\n응원드립니다. ","u":"14f62405"},{"i":"336818c3e7","t":"23:07:12","s":"서@기(세눈까마귀)","k":"emoticon","x":"이모티콘","u":"bc3d1647"}]}